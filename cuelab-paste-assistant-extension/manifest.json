{
  "manifest_version": 3,
  "name": "CueLab Paste Assistant",
  "version": "0.3.1",
  "description": "Guided, Golden-Check-aware transfer assistant for moving reviewed CueLab bridge data into Beatpulse.",
  "permissions": [
    "activeTab",
    "clipboardRead",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "https://app.beatpulse.com/*"
  ],
  "action": {
    "default_title": "CueLab Paste Assistant",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.beatpulse.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "copy-current": {
      "suggested_key": {
        "mac": "Command+Shift+Y"
      },
      "description": "Copy current queue value"
    },
    "next-item": {
      "suggested_key": {
        "mac": "Command+Shift+U"
      },
      "description": "Move to next queue value"
    },
    "prev-item": {
      "suggested_key": {
        "mac": "Command+Shift+J"
      },
      "description": "Move to previous queue value"
    },
    "toggle-panel": {
      "suggested_key": {
        "mac": "Command+Shift+L"
      },
      "description": "Show or hide the paste assistant"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  }
}
